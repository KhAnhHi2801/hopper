/// Stores encrypted third-party API credentials (Printify, Shopify, ...).
/// Uses envelope encryption (KEK/DEK pattern): each credential has its own
/// Data Encryption Key (DEK), and the DEK itself is encrypted ("wrapped") by
/// a Master Key (KEK) that lives only in the MASTER_KEY env var — never in
/// this database. Only orchestration-service ever decrypts these values.
model Credential {
  id       String @id @default(uuid())
  /// Which external platform this credential belongs to, e.g. "printify", "shopify".
  platform String

  /// The encrypted secret itself (AES-256-GCM output). Never plaintext.
  ciphertext Bytes
  /// Initialization vector used for this specific encryption — required to decrypt.
  iv         Bytes
  /// AES-GCM authentication tag — lets decryption detect if ciphertext was tampered with.
  authTag    Bytes
  /// The DEK that encrypted `ciphertext`, itself encrypted ("wrapped") by the KEK.
  wrappedDek Bytes

  /// Which KEK version wrapped this DEK. Lets the KEK be rotated later without
  /// forcing an immediate re-encryption of every existing credential.
  keyVersion Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
