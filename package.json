{
  "name": "hopper",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "npm run lint -- --fix",
    "prettier": "prettier --cache --cache-location ./node_modules/.cache/prettier .",
    "prettier:fix": "npm run prettier -- --write",
    "format": "npm run prettier:fix && npm run lint:fix",
    "prepare": "husky",
    "test": "npm test --workspaces --if-present"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,d.ts}": [
      "prettier --cache --cache-location ./node_modules/.cache/prettier --write",
      "eslint --cache --cache-location ./node_modules/.cache/eslint --fix --max-warnings=0"
    ],
    "**/*.md": [
      "prettier --cache --cache-location ./node_modules/.cache/prettier --write"
    ]
  }
}
